# Lumen C++ demo on ESP32-S3.
CONFIG_IDF_TARGET="esp32s3"

# The UI renders on a normal task, not in an ISR; 8 KiB is plenty for the
# page stack plus the demo's per-page state.
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192

# The component is built without exceptions/RTTI.
CONFIG_COMPILER_CXX_EXCEPTIONS=n
CONFIG_COMPILER_CXX_RTTI=n

CONFIG_LOG_DEFAULT_LEVEL_INFO=y
